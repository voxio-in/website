// Neon Postgres. Two URLs because the app and Prisma Migrate need different
// connections: the app uses Neon's pooler, while migrations take advisory locks
// that a pooled connection cannot hold, so they use the direct host.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  org       String?
  email     String
  surface   String?
  message   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, createdAt])
}

model CallRequest {
  id         String   @id @default(cuid())
  phone      String
  desk       String   @default("university")
  org        String?
  status     CallStatus @default(pending)
  gatewayRef String?
  error      String?
  ip         String?
  userAgent  String?
  transcript Json?
  outcome    String?
  endedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([gatewayRef])
  @@index([phone, createdAt])
  @@index([ip, createdAt])
}

enum CallStatus {
  pending
  dialing
  completed
  failed
  blocked
}

model RoomSession {
  id         String    @id @default(cuid())
  demo       String
  transcript Json?
  // The roleplay beats — face changes, physical actions and the running score
  // — appended as the voice server posts them, so the live room can poll them
  // back and draw the scene. See webhookPayload.sceneBeats.
  scene      Json?
  seconds    Int?
  endedAt    DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([ip, createdAt])
}
