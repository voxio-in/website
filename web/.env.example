# Neon (serverless Postgres). Both URLs come from the Neon dashboard: the app
# uses the pooled connection, Prisma Migrate needs the direct one — the same
# host with "-pooler" removed — because migrations take advisory locks that a
# pooled connection cannot hold.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# The calling demo on /calling. The gateway authorises a call with two headers:
# user_api_key (which tenant) and flow_api_key (which workflow) — so there is
# one flow key per desk. A desk with no key here is simply not offered a call:
# the page says so rather than failing at the gateway.
# The three backends. A host or a full URL both work.
VX_VOICEBOT="voice.voxio.in"          # browser WebRTC, audio only
VX_VOICEBOT_GPU="gpu.voice.voxio.in"  # browser WebRTC with an avatar (GPU box)
VX_CALLBOT="call.voxio.in"            # telephony
VOXIO_FROM_NUMBER="918031321074"              # the Plivo number we dial out from
VOXIO_USER_API_KEY=""
VOXIO_FLOW_API_KEY_UNIVERSITY=""
VOXIO_FLOW_API_KEY_SCHOOL=""
VOXIO_FLOW_API_KEY_OPD=""
VOXIO_FLOW_API_KEY_HOTEL=""
